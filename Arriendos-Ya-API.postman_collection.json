            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"MANTENCION\",\n  \"descripcion\": \"Revision preventiva de la propiedad\",\n  \"fecha\": \"2026-07-25T17:55:36-04:00\",\n  \"url\": \"https://example.com/documentos/mantencion\",\n  \"propiedad\": {\n    \"id\": {{propiedadId}}\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/eventos"
          }
        }
      ]
