{
  "info": {
    "_postman_id": "b84c9a60-0d02-4f7d-91b1-bbf974ff08a0",
    "name": "Arriendos Ya API",
    "description": "Coleccion para consumir la API de Arriendos Ya.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "propietarioRut", "value": "12345678-9" },
    { "key": "arrendatarioRut", "value": "98765432-1" },
    { "key": "propiedadId", "value": "1" },
    { "key": "arriendoId", "value": "1" }
  ],
  "item": [
    {
      "name": "Propietarios",
      "item": [
        {
          "name": "Listar propietarios",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/propietarios"
          }
        },
        {
          "name": "Obtener propietario por RUT",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/propietarios/{{propietarioRut}}"
          }
        },
        {
          "name": "Crear propietario",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rut\": \"{{propietarioRut}}\",\n  \"nombre\": \"Ana\",\n  \"apellido\": \"Gonzalez\",\n  \"telefono\": \"+56912345678\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/propietarios"
          }
        },
        {
          "name": "Actualizar propietario",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana Maria\",\n  \"apellido\": \"Gonzalez\",\n  \"telefono\": \"+56987654321\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/propietarios/{{propietarioRut}}"
          }
        },
        {
          "name": "Eliminar propietario",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/propietarios/{{propietarioRut}}"
          }
        }
      ]
    },
