        {
          "name": "Listar propiedades",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/propiedades"
          }
        },
        {
          "name": "Obtener propiedad por ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/propiedades/{{propiedadId}}"
          }
        },
        {
          "name": "Crear propiedad",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"direccion\": \"Av. Libertad 123\",\n  \"comuna\": \"Vina del Mar\",\n  \"ciudad\": \"Vina del Mar\",\n  \"region\": \"Valparaiso\",\n  \"numeroHabitaciones\": 3,\n  \"numeroBanos\": 2,\n  \"precioArriendo\": 650000,\n  \"disponible\": true,\n  \"propietario\": {\n    \"rut\": \"{{propietarioRut}}\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/propiedades"
          }
        },
        {
          "name": "Actualizar propiedad",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"direccion\": \"Av. Libertad 456\",\n  \"comuna\": \"Vina del Mar\",\n  \"ciudad\": \"Vina del Mar\",\n  \"region\": \"Valparaiso\",\n  \"numeroHabitaciones\": 4,\n  \"numeroBanos\": 2,\n  \"precioArriendo\": 720000,\n  \"disponible\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/propiedades/{{propiedadId}}"
          }
        },
        {
          "name": "Asignar propietario a propiedad",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/propiedades/{{propiedadId}}/asignar-propietario/{{propietarioRut}}"
          }
        },
        {
          "name": "Eliminar propiedad",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/propiedades/{{propiedadId}}"
          }
        }
      ]
    },
    {
      "name": "Arriendos",
      "item": [
        {
          "name": "Listar arriendos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/arriendos"
          }
        },
        {
          "name": "Listar arriendos por propiedad",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/arriendos/propiedad/{{propiedadId}}"
          }
        },
        {
          "name": "Listar arriendos por arrendatario",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/arriendos/arrendatario/{{arrendatarioRut}}"
          }
        },
        {
          "name": "Crear arriendo",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"propiedad\": {\n    \"id\": {{propiedadId}}\n  },\n  \"arrendatario\": {\n    \"rut\": \"{{arrendatarioRut}}\"\n  },\n  \"fechaInicio\": \"2026-07-01\",\n  \"activo\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/arriendos"
          }
        },
        {
          "name": "Finalizar arriendo",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/arriendos/{{arriendoId}}/finalizar?fechaTermino=2026-07-31",
              "query": [{ "key": "fechaTermino", "value": "2026-07-31" }]
            }
          }
        }
      ]
    },
    {
      "name": "Eventos",
      "item": [
        {
          "name": "Listar eventos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/eventos"
